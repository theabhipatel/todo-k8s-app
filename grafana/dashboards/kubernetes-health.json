        {
            "id": 5,
            "title": "CPU Usage by Pod",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"todo-app\",container!=\"\",container!=\"POD\"}[5m]))",
                    "legendFormat": "{{pod}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "cores"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            }
        },
        {
            "id": 6,
            "title": "Memory Usage by Pod",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "targets": [
                {
                    "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"todo-app\",container!=\"\",container!=\"POD\"})",
