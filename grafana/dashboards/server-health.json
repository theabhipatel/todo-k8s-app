{
    "annotations": {
        "list": []
    },
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "id": 1,
            "title": "CPU Usage",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto"
            }
        },
        {
            "id": 2,
            "title": "Memory Usage",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 8,
                "y": 0
            },
            "targets": [
                {
                    "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto"
            }
        },
        {
            "id": 3,
            "title": "Disk Usage",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 16,
                "y": 0
            },
            "targets": [
                {
                    "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}) * 100)",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "values": false
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto"
            }
        },
        {
            "id": 4,
            "title": "Network Traffic",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 24,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "expr": "sum(rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))",
                    "legendFormat": "Received",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))",
                    "legendFormat": "Transmitted",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            }
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
        "todo-app",
        "server"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timezone": "browser",
    "title": "Server Health",
    "uid": "todo-server-health",
    "version": 1
}